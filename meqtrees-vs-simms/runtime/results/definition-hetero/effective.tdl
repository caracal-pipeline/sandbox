[sim]
# compile-time options follow
ms_sel.msname = /tmp/meq-native-runs/final.ms
ms_sel.ms_ifr_subset_str = all
ms_sel.ms_corr_sel = 2x2
run_purr = 0
sim_mode = sim only
read_ms_model = 0
tensormeqmaker.psv_class = PSVTensor
me.use_jones_inspectors = 0
me.use_skyjones_visualizers = 0
me.use_smearing = 0
uvw_source = from MS
uvw_refant = default
me.sky.tiggerskymodel = 1
tiggerlsm.filename = /workspace/scratch/a2e4ee446bfb/fixture-runs/tiny-final/sky.txt
tiggerlsm.lsm_subset = all
tiggerlsm.null_subset = None
tiggerlsm.solvable_sources = 0
me.sky.siamese_oms_gridded_sky = 0
me.sky.siamese_agw_azel_sky = 0
me.sky.siamese_oms_transient_sky = 0
me.sky.siamese_oms_fitsimage_sky = 0
me.ncorr_enable = 0
me.z_enable = 0
me.l_enable = 0
me.e_enable = 1
me.e_module = Siamese_OMS_pybeams_fits
pybeams_fits.filename_pattern = /workspace/scratch/a2e4ee446bfb/fixture-runs/tiny-final/meqtrees-hetero.json
pybeams_fits.beam_type = 2x2
pybeams_fits.missing_is_null = 0
pybeams_fits.spline_order = 3
pybeams_fits.normalize_gains = 1
pybeams_fits.ampl_interpolation = 0
pybeams_fits.l_axis = px
pybeams_fits.m_axis = py
pybeams_fits.l_beam_offset = 0.0
pybeams_fits.m_beam_offset = 0.0
pybeams_fits.sky_rotation = 1
pybeams_fits.verbose_level = 0
me.epe_enable = 0
me.e_advanced = 0
me.p_enable = 1
feed_angle.read_ms = 0
feed_angle.enable_pa = 0
feed_angle.feed_angle = 0
me.p_advanced = 0
me.d_enable = 0
me.g_enable = 0
me.ip_enable = 0
noise_stddev = None
noise_from_sefd = 0
random_seed = time
# runtime options follow
ms_sel.ms_taql_str = None
ms_sel.output_column = CORRECTED_DATA
ms_sel.select_channels = 0
ms_sel.tile_size = 8
